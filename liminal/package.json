{
  "name": "liminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "build:page": "vite build --mode page && node tools/make-page.mjs",
    "bench:bake": "vite-node tools/bench/bake-bench.ts",
    "gen:blank": "vite-node tools/gen-blank.ts",
    "studio": "node tools/studio/cli.mjs",
    "fetch:textures": "python3 tools/fetch_textures.py"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
