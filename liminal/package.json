{
  "name": "liminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "gen:testmap": "vite-node tools/gen-test-map.ts",
    "build:page": "vite build --mode page && node tools/make-page.mjs",
    "bench:bake": "vite-node tools/bench/bake-bench.ts",
    "fetch:textures": "python3 tools/fetch_textures.py",
    "gen:pmp": "vite-node tools/gen-pmp-basement.ts",
    "gen:mall": "vite-node tools/gen-mall.ts",
    "gen:flatgrass": "vite-node tools/gen-flatgrass.ts",
    "gen:nook": "vite-node tools/gen-nook.ts",
    "gen:rec": "vite-node tools/gen-rec-room.ts",
    "gen:laquinta": "vite-node tools/gen-laquinta.ts",
    "gen:industrial": "vite-node tools/gen-industrial.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
